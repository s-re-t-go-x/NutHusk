{
  "id": "com.example.json-formatter",
  "name": "JSON 格式化",
  "version": "1.0.0",
  "apiVersion": "^1.0.0",
  "description": "格式化、压缩、校验 JSON 文本（纯前端，无后端进程）",
  "icon": "icon.svg",
  "category": "开发",
  "keywords": [
    "json",
    "格式化"
  ],
  "ui": "ui.html",
  "permissions": [],
  "match": {
    "regex": [
      "^\\s*(?:\\{[\\s\\S]*\\}|\\[[\\s\\S]*\\])\\s*$"
    ],
    "extensions": [
      "json"
    ],
    "minLength": 2,
    "label": "识别为 JSON 文本"
  },
  "actions": [
    {
      "id": "format",
      "name": "JSON 格式化",
      "method": "format",
      "description": "美化 JSON 文本（2 空格缩进）",
      "defaultParams": { "indent": 2 }
    },
    {
      "id": "minify",
      "name": "JSON 压缩",
      "method": "minify",
      "description": "移除空白字符，压缩为单行 JSON"
    }
  ]
}
