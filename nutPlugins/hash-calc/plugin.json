{
  "id": "com.example.hash-calc",
  "name": "哈希计算",
  "version": "1.0.0",
  "apiVersion": "^1.0.0",
  "description": "计算文本的 MD5 / SHA 哈希（演示进程外后端，示例用 Node 编写）",
  "icon": "icon.svg",
  "category": "开发",
  "keywords": [
    "hash",
    "md5",
    "sha256"
  ],
  "ui": "ui.html",
  "backend": {
    "command": "node",
    "args": [
      "main.js"
    ]
  },
  "permissions": [],
  "match": {
    "minLength": 1,
    "maxLength": 10000,
    "label": "计算文本哈希"
  }
}
