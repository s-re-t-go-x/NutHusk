{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "NutHusk",
  "version": "0.1.0",
  "identifier": "com.example.NutHusk",
  "build": {
    "frontendDist": "../src"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "NutHusk",
        "width": 1100,
        "height": 720,
        "minWidth": 720,
        "minHeight": 480,
        "dragDropEnabled": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: plugin: http://plugin.localhost; connect-src ipc: http://ipc.localhost; frame-src plugin: http://plugin.localhost"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "resources": {
      "../nutPlugins/": "nutPlugins/"
    }
  }
}